<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Ranking of the Original 62 - Goosebumps Gazette</title>
  <link href="https://fonts.googleapis.com/css2?family=Rubik+Wet+Paint&display=swap" rel="stylesheet">
  
  <style>
    body {
      margin: 0;
      background-color: black;
      color: white;
      font-family: Arial, sans-serif;
    }

    /* Top title (Links back to home page) */
    .title {
      display: block; 
      text-align: center;
      font-size: 70px;
      color: #00cc44;
      font-family: 'Rubik Wet Paint', cursive;
      margin-top: 30px;
      margin-bottom: 10px;
      letter-spacing: 2px;
      text-decoration: none; 
      
      /* glow effect */
      text-shadow:
        0 0 2px #00cc44,
        0 0 6px #009933,
        0 0 12px #006622;
    }

    /* Middle content column */
    .content {
      width: 50%;
      margin: 0 auto;
      border-left: 4px solid #b30000;
      border-right: 4px solid #b30000;
      padding: 20px;
      min-height: 100vh;
      box-sizing: border-box;
      text-align: center; 
    }

    /* When screen gets smaller */
    @media (max-width: 900px) {
      .content {
        width: 80%;
      }
    }

    @media (max-width: 600px) {
      .content {
        width: 95%;
        border-left: none;
        border-right: none;
      }
    }

    /* Subtitle */
    .subtitle {
      color: #00aa00;
      text-decoration: underline;
      font-size: 24px;
      margin-top: 20px;
      margin-bottom: 20px;
    }

    /* Ranking List Styling */
    .ranking-list {
      text-align: left; /* Keeps the list neat, but centered in the column */
      display: inline-block;
      margin: 0 auto;
      padding-left: 20px;
    }

    li {
      margin: 10px 0;
      font-size: 18px;
    }

    /* Back Home Link */
    .back-link {
      color: #00aa00;
      display: inline-block;
      margin-top: 40px;
      text-decoration: none;
    }
    .back-link:hover {
      text-decoration: underline;
    }
    
    a.title:hover {
      text-decoration: none;
      color: #00cc44;
    }
  </style>
</head>

<body>

  <a href="index.html" class="title">Goosebumps Gazette</a>

  <div class="content">

    <div class="subtitle">Ranking of the Original 62</div>

    <ol class="ranking-list">
      <li>Welcome to Dead House</li>
      <li>Stay Out of the Basement</li>
      <li>Monster Blood</li>
      <li>Say Cheese and Die!</li>
      </ol>

    <br>
    <a href="index.html" class="back-link">← Back to Main Page</a>

  </div>

</body>
</html>
